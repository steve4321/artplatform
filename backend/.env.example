# ArtPlatform Environment Configuration
# Copy this file to .env and fill in the values

# ── Local Development (no Docker required) ──────────────────────────────
# Set LOCAL_DEV=true to run without PostgreSQL/Redis/MinIO:
#   Database  → SQLite (stored under backend/.local_dev/)
#   Storage   → Local filesystem (under backend/.local_dev/storage/)
#   Celery    → Eager mode (tasks run inline, no Redis needed)
# WARNING: LOCAL_DEV is for local development only. Do NOT set LOCAL_DEV=true
# in Docker deployments — containers should always use PostgreSQL/Redis/MinIO.
LOCAL_DEV=false

# Database (ignored when LOCAL_DEV=true)
DATABASE_URL=postgresql+asyncpg://artplatform:artplatform@localhost:5432/artplatform

# Redis (ignored when LOCAL_DEV=true)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 (ignored when LOCAL_DEV=true)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=artplatform

# Auth
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery (ignored when LOCAL_DEV=true)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Processor Mode ──────────────────────────────────────────────────────────
# Controls which AI implementation is used:
#   mock   — fake output for development (default)
#   cloud  — GPU stages via ProviderRouter (cloud APIs), CPU stages local
#   local  — self-hosted GPU inference (requires CUDA + models)
PROCESSOR_MODE=mock

# ── Text-to-Image Providers (used when PROCESSOR_MODE=cloud) ────────────────
# Primary provider
TEXT_TO_IMAGE_PROVIDER=stability_ai
# Fallback chain (comma-separated, tried in order on failure)
TEXT_TO_IMAGE_FALLBACKS=fal_ai,replicate

# Stability AI (SDXL): $0.003/image
STABILITY_API_KEY=
STABILITY_BASE_URL=
STABILITY_TIMEOUT=60

# fal.ai (fast SDXL): ~$0.005/image
FAL_API_KEY=
FAL_TIMEOUT=120

# Replicate (SDXL): ~$0.003/image
REPLICATE_API_KEY=
REPLICATE_TIMEOUT=120

# ComfyUI (self-hosted)
COMFYUI_URL=
COMFYUI_TIMEOUT=180

# ── Image-to-3D Providers ────────────────────────────────────────────────────
IMAGE_TO_3D_PROVIDER=tripo_cloud
IMAGE_TO_3D_FALLBACKS=meshy_ai,csm_ai

# Tripo Cloud (image→GLB): ~¥0.3/次
TRIPO_API_KEY=
TRIPO_TIMEOUT=120

# Meshy AI (image→GLB, multiple styles): ~$0.05/次
MESHY_API_KEY=
MESHY_TIMEOUT=120

# CSM AI (image→GLB, character support): ~$0.03/次
CSM_API_KEY=
CSM_TIMEOUT=120

# ── Self-Hosted GPU Inference (used when PROCESSOR_MODE=local) ──────────────
SELF_HOSTED_SDXL=false
SELF_HOSTED_SDXL_URL=http://localhost:8001
SDXL_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0

SELF_HOSTED_TRIPOSR=false
SELF_HOSTED_TRIPOSR_URL=http://localhost:8002
TRIPOSR_MODEL_PATH=

# ── Provider Routing ────────────────────────────────────────────────────────
# If true, router picks cheapest available provider instead of using primary
PROVIDER_COST_PRIORITY=false
